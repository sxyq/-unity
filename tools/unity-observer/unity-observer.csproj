<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unity 2021.3 (Mono) 只读状态观察器。
       构建时传入厂商 Managed 目录（本机路径，不写入仓库）：
         dotnet build -c Release -p:UNITY_MANAGED="C:\...\HLF10631030_Data\Managed"
       只引用 UnityEngine.CoreModule.dll，不引用任何厂商业务程序集。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>GqyStateObserver</AssemblyName>
    <RootNamespace>Gqy</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UNITY_MANAGED Condition="'$(UNITY_MANAGED)' == ''">$(MSBuildProjectDirectory)/ref</UNITY_MANAGED>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UNITY_MANAGED)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
