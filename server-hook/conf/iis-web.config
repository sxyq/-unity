<?xml version="1.0" encoding="utf-8"?>
<!--
  方案 T2-IIS：站点跑在 IIS 上时（响应头 X-Powered-By: ASP.NET），
  用 URL Rewrite 的出站规则在 </head> 前插一行 script，入站规则把
  /mengoo/__ai/* 反代到本机 8788。

  前提：
    1. 已安装 URL Rewrite 2.0 + Application Request Routing（ARR），并启用 proxy
    2. 站点根目录 web.config 可改（这是全站唯一改动点）
    3. 原站点不要开静态压缩，否则出站规则匹配不到 </head>

  回滚：把本文件恢复成原样（或删掉 <rewrite> 整段），IIS 立即恢复。
-->
<configuration>
  <system.webServer>

    <rewrite>
      <!-- 入站：智能服务反代 -->
      <rules>
        <rule name="GouQianYinAiService" stopProcessing="true">
          <match url="^mengoo/__ai/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8788/{R:1}" />
        </rule>
      </rules>

      <!-- 出站：只改 text/html，其他响应一律不动 -->
      <outboundRules rewriteBeforeCache="true">
        <rule name="InjectGouQianYinHook" preCondition="IsHtml">
          <match filterByTags="None" pattern="&lt;/head&gt;" />
          <action type="Rewrite"
                  value="&lt;script src=&quot;/mengoo/__ai/hook.js&quot; defer&gt;&lt;/script&gt;&lt;/head&gt;" />
        </rule>
        <preConditions>
          <preCondition name="IsHtml">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- 去掉 ASP.NET 版本标识（与本次功能无关，但审查时通常一并要求） -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
